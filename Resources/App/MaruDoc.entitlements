<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-download build: not sandboxed (needs Accessibility, an event tap and Finder Apple Events).
	     No network entitlement exists for unsandboxed apps; the code simply contains no networking. -->
	<key>com.apple.security.automation.apple-events</key><true/>
	<!-- Shared with the Finder extension: carries the token that authenticates marudoc://run requests. -->
	<key>com.apple.security.application-groups</key>
	<array><string>FC2V887B8C.app.marudoc</string></array>
</dict>
</plist>
